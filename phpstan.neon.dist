includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
        - database
    tmpDir: build/phpstan
    ignoreErrors:
        # Public entry point for domains that upload images (Catalog, Content);
        # consumers land in later epics, so nothing under src/ uses it yet.
        -
            identifier: trait.unused
            path: src/Media/Concerns/HasBazaarMedia.php
